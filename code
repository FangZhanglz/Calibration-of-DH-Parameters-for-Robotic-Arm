// ---- SO(3) helpers ----
static inline Matrix3d Rz(double t) {
    double c = std::cos(t), s = std::sin(t);
    Matrix3d R; R << c, -s, 0, s, c, 0, 0, 0, 1; return R;
}
static inline Matrix3d Rx(double a) {
    double c = std::cos(a), s = std::sin(a);
    Matrix3d R; R << 1, 0, 0, 0, c, -s, 0, s, c; return R;
}

// ---- 计算每个关节在姿态 q 下的方向基 u_ix, u_iz ----
// 只依赖已知 alpha_i 与 theta_i；与未知 a_i,d_i 无关。
struct UDirs {
    vector<Vector3d> ux; // size N
    vector<Vector3d> uz; // size N
};
static UDirs compute_u_dirs(const VectorXd& alpha, const VectorXd& q) {
    const int N = (int)q.size();
    UDirs U; U.ux.resize(N); U.uz.resize(N);
    //Matrix3d Rprev = Matrix3d::Identity();
    Matrix3d Rprev;
    Rprev << 0, 0, 1,
        1, 0, 0,
        0, 1, 0;

    for (int i = 0; i < N; ++i) {
        Matrix3d Rzi = Rz(q[i]);
        // 当前关节的 a_i 与 d_i 分别沿 x、z 的基向量（已变换到基坐标）
        U.ux[i] = Rprev * Rzi * Vector3d(1, 0, 0); // 对应 a_i 的方向
        U.uz[i] = Rprev * Rzi * Vector3d(0, 0, 1); // 对应 d_i 的方向
        // 更新到下一关节的前置旋转
        Rprev = Rprev * Rzi * Rx(alpha[i]);
    }
    return U;
}

// ---- 单对触碰（两姿态）生成残差与梯度 ----
struct PairMeasure {
    VectorXd q1, q2; // 两次触碰的关节角（弧度），长度 N
    double L;        // 标定杆真实长度
};

struct Problem {
    int N;                 // 轴数
    VectorXd alpha;        // 固定 DH alpha_i，长度 N
    vector<PairMeasure> ms;// 多对触碰
};

// v = B_k * x 的快速计算；同时返回单位方向 v_hat 和模长 ||v||
static inline void eval_v_and_dir(
    const UDirs& U1, const UDirs& U2,
    const VectorXd& x, int N,
    Vector3d& p1, Vector3d& p2,    // 新增输出：两个末端位置
    Vector3d& v, Vector3d& vhat, double& vnorm)
{
    // x = [a_1..a_N, d_1..d_N]
    p1.setZero();
    p2.setZero();
    for (int i = 0; i < N; ++i) {
        double ai = x[i];
        double di = x[N + i];
        p1 += ai * U1.ux[i] + di * U1.uz[i]; // 在姿态1下累加位置分量
        p2 += ai * U2.ux[i] + di * U2.uz[i]; // 在姿态2下累加位置分量
    }
    v = p1 - p2;                       // 位置差向量
    vnorm = v.norm();                  // 模长
    //std::cout << "L:" << vnorm << endl;
    //std::cout<<"p1:"<<p1[0]<<"|" << p1[1] << "|" << p1[2] << endl;
    //std::cout << "p2:" << p2[0] << "|" << p2[1] << "|" << p2[2] << endl;
    vhat = (vnorm > 1e-12) ? (v / vnorm) : Vector3d(0, 0, 0); // 单位方向
}

// 计算单个约束的残差 r_k 与梯度 g_k = d r_k / d x （长度 2N）
static inline void residual_and_grad(
    const Problem& P, const PairMeasure& m, const VectorXd& x,
    double& r, VectorXd& g)
{
    const int N = P.N;
    UDirs U1 = compute_u_dirs(P.alpha, m.q1);
    UDirs U2 = compute_u_dirs(P.alpha, m.q2);


    Vector3d p1, p2, v, vhat; double vnorm;
    eval_v_and_dir(U1, U2, x, N, p1, p2, v, vhat, vnorm);

    r = vnorm - m.L;        // 距离残差：||B x|| - L
    g.setZero(2 * N);
    if (vnorm <= 1e-12) return;

    // g = B^T * vhat；逐列累加，避免显式构造 B（3x2N）
    for (int i = 0; i < N; ++i) {
        Vector3d dix = (U1.ux[i] - U2.ux[i]);
        Vector3d diz = (U1.uz[i] - U2.uz[i]);
        g[i] = vhat.dot(dix); // 对 a_i
        g[N + i] = vhat.dot(diz); // 对 d_i
    }
}

// ---- LM/GN 求解：最小化 sum_k (||B_k x|| - L)^2 ----
struct SolverOptions {
    int   max_iters = 200;
    double lambda0 = 1e-6;   // LM 初始阻尼
    double tol_dx = 1e-20;   // 增量范数停止
    double tol_grad = 1e-15;   // 梯度无穷范数停止
    bool  use_LM = true;   // false => 纯 GN
    bool  verbose = true;   // 新增：打印开关
};

// 计算所有残差向量（便于收尾打印）
static VectorXd compute_residuals(const Problem& P, const VectorXd& x) {
    VectorXd r(P.ms.size());
    for (size_t k = 0; k < P.ms.size(); ++k) {
        double rk; VectorXd g(2 * P.N);
        residual_and_grad(P, P.ms[k], x, rk, g);
        r[(int)k] = rk;
    }
    return r;
}

struct SolverResult {
    VectorXd x;
    int iters = 0;
    double final_cost = 0;
    bool converged = false;
};

static SolverResult solve_ad_length(const Problem& P, const VectorXd& x0, const SolverOptions& opt) {
    const int N = P.N;
    const int D = 2 * N;
    VectorXd x = x0;
    double lambda = opt.lambda0;

    auto eval_cost = [&](const VectorXd& x)->double {
        double c = 0;
        for (const auto& m : P.ms) {
            double r; VectorXd g(D);
            residual_and_grad(P, m, x, r, g);
            c += r * r;
        }
        return 0.5 * c;
    };

    for (int it = 0; it < opt.max_iters; ++it) {
        MatrixXd H = MatrixXd::Zero(D, D);
        VectorXd b = VectorXd::Zero(D);
        double cost = 0;
        VectorXd g_inf = VectorXd::Zero(D);
        double max_abs_r = 0.0;                  // 新增：跟踪本轮最大残差

        for (const auto& m : P.ms) {
            double r; VectorXd g(D);
            residual_and_grad(P, m, x, r, g);
            H.noalias() += g * g.transpose();
            b.noalias() += g * r;
            cost += r * r;
            g_inf = g.cwiseAbs().cwiseMax(g_inf);
            if (std::abs(r) > max_abs_r) max_abs_r = std::abs(r);
        }
        cost *= 0.5;

        MatrixXd Hreg = H;
        if (opt.use_LM) Hreg.diagonal().array() += lambda;
        VectorXd dx = -Hreg.ldlt().solve(b);

        if (opt.verbose) {
            std::cout << "[iter " << (it + 1) << "] "
                << "cost=" << cost
                << "  max|r|=" << max_abs_r
                << "  |dx|=" << dx.norm()
                << "  lambda=" << (opt.use_LM ? lambda : 0.0)
                << "\n";
        }

        if (g_inf.maxCoeff() < opt.tol_grad) {
            if (opt.verbose) {
                auto rv = compute_residuals(P, x);
                std::cout << "Converged by grad. Final residuals:\n";
                for (int k = 0; k < rv.size(); ++k)
                    std::cout << "  r[" << k << "]=" << rv[k] << "\n";
            }
            return { x, it, cost, true };
        }
        if (dx.norm() < opt.tol_dx) {
            if (opt.verbose) {
                auto rv = compute_residuals(P, x);
                std::cout << "Converged by step. Final residuals:\n";
                for (int k = 0; k < rv.size(); ++k)
                    std::cout << "  r[" << k << "]=" << rv[k] << "\n";
            }
            return { x, it, cost, true };
        }

        if (opt.use_LM) {
            double new_cost = eval_cost(x + dx);
            if (new_cost < cost) {
                x += dx;
                lambda = std::max(lambda * 0.3, 1e-12);
            }
            else {
                lambda = std::min(lambda * 3.0, 1e12);
            }
        }
        else {
            x += dx;
        }

        if (it == opt.max_iters - 1) {
            if (opt.verbose) {
                auto rv = compute_residuals(P, x);
                std::cout << "Max iters reached. Final residuals:\n";
                for (int k = 0; k < rv.size(); ++k)
                    std::cout << "  r[" << k << "]=" << rv[k] << "\n";
            }
            return { x, it + 1, eval_cost(x), false };
        }
    }
    return { x0, opt.max_iters, eval_cost(x0), false };
}

